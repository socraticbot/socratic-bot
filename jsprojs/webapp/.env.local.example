# Vercel AI Gateway
# Get this from your Vercel dashboard. Must start with 'vck_'.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key

# Chat Password Protection
# Password required to access /chat page. Prevents unauthorized usage.
# IMPORTANT: Set a strong password before deployment!
CHAT_PASSWORD=your_secure_password_here

# Optional: Mistral Model (not currently used - models are hardcoded)
# MISTRAL_MODEL=mistral/mistral-large-latest

# Optional: Swarm (for future features)
# SWARM_GATEWAY_URL=https://gateway.ethswarm.org

# Optional: Wallet Authentication (for future features)
# WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional: Encryption (for future features)
# ENCRYPTION_SECRET=your_encryption_secret

# Environment
NODE_ENV=development

# Next.js Public URL (for local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
