# Socratic Bot Environment Variables
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will not be committed

# Vercel AI Gateway
VERCEL_AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key

# Swarm Gateway (optional, defaults to public gateway)
SWARM_GATEWAY_URL=https://gateway.ethswarm.org

# WalletConnect
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Encryption Secret (generate a strong random string)
ENCRYPTION_SECRET=your_encryption_secret

# Environment
NODE_ENV=development

# Next.js Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
